{
  "id": "test",
  "version": "1",
  "stages": [
    {
      "id": "A",
      "title": "Design",
      "develop": {
        "nodes": [
          {
            "id": "drc",
            "plugin": "stub-tool",
            "handler": "report",
            "inputs": {
              "design": "slot:design"
            },
            "bind": {
              "report": "drc-report"
            },
            "judge": [
              "stub.drc"
            ]
          },
          {
            "id": "flaky",
            "plugin": "stub-tool",
            "handler": "flaky",
            "inputs": {
              "design": "slot:design"
            },
            "after": [
              "drc"
            ],
            "bind": {
              "report": "flaky-report"
            }
          },
          {
            "id": "wrapup",
            "plugin": "stub-tool",
            "handler": "sleep",
            "params": {
              "ms": 10
            },
            "after": [
              "flaky"
            ]
          }
        ]
      },
      "tests": [
        {
          "check": "stub.drc",
          "inputs": {
            "design": "slot:design"
          }
        },
        {
          "check": "stub.limit",
          "inputs": {
            "design": "slot:design"
          },
          "params": {
            "limit": 5
          }
        }
      ]
    },
    {
      "id": "B",
      "title": "Signoff",
      "develop": {
        "defaults": {
          "spec": "data:test-spec"
        },
        "nodes": [
          {
            "id": "steps",
            "plugin": "stub-tool",
            "handler": "steps",
            "params": {
              "steps": 6,
              "stepMs": 400
            },
            "inputs": {
              "design": "slot:design"
            },
            "bind": {
              "report": "steps-report"
            }
          }
        ]
      }
    },
    {
      "id": "C",
      "title": "Package",
      "tests": [
        {
          "check": "stub.drc",
          "inputs": {
            "design": "slot:package"
          }
        }
      ],
      "develop": {
        "nodes": [
          {
            "id": "registry",
            "plugin": "stub-tool",
            "handler": "report",
            "inputs": {
              "design": "slot:design"
            },
            "bind": {
              "report": "registry"
            }
          }
        ]
      }
    }
  ],
  "checks": [
    {
      "id": "stub.drc",
      "version": "1",
      "title": "Design rule check",
      "plugin": "stub-tool",
      "handler": "report",
      "completeness": [
        {
          "metric": "coverage.complete",
          "op": "==",
          "value": true
        }
      ],
      "criteria": [
        {
          "metric": "violations",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "stub.mfg",
      "version": "1",
      "title": "Manufacturing rule check",
      "plugin": "stub-tool",
      "handler": "report",
      "criteria": [
        {
          "metric": "violations",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "stub.timing",
      "version": "1",
      "title": "SDF timing simulation",
      "plugin": "stub-tool",
      "handler": "report",
      "requiredCapability": "sdf",
      "criteria": [
        {
          "metric": "violations",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "stub-tool.qualify.sdf",
      "version": "1",
      "title": "Qualification of the stub tool's SDF capability",
      "plugin": "stub-tool",
      "handler": "qualify",
      "criteria": [
        {
          "metric": "detected",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "stub.limit",
      "version": "1",
      "title": "Violations within a limit, when one is set",
      "plugin": "stub-tool",
      "handler": "report",
      "criteria": [
        {
          "metric": "violations",
          "op": ">=",
          "value": 0
        },
        {
          "metric": "limit.met",
          "op": "==",
          "value": true,
          "when": {
            "metric": "limit.set",
            "op": "==",
            "value": true
          }
        }
      ]
    }
  ],
  "hardConstraintSlots": [
    "registry"
  ]
}
