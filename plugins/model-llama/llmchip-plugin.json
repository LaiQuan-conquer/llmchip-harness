{
  "id": "model-llama",
  "version": "0.3.0",
  "title": "Llama-family model import, tensor census, graph recovery and L0 reference",
  "kinds": [
    "model-loader"
  ],
  "runtime": "process",
  "entry": {
    "command": [
      "${python}",
      "-m",
      "llmchip_model"
    ]
  },
  "kernelApi": "^0.3",
  "handlers": [
    {
      "name": "synthesize",
      "title": "Proxy model: the structure of a planned model with fixed-seed, untrained weights and a character tokenizer",
      "outputs": [
        {
          "name": "weights",
          "type": "model.weights.llama2c",
          "mediaType": "application/octet-stream"
        },
        {
          "name": "tokenizer",
          "type": "model.tokenizer.llama2c",
          "mediaType": "application/octet-stream"
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dim",
          "hiddenDim",
          "layers",
          "heads",
          "kvHeads",
          "seqLen"
        ],
        "properties": {
          "dim": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4096
          },
          "hiddenDim": {
            "type": "integer",
            "minimum": 2,
            "maximum": 16384
          },
          "layers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "heads": {
            "type": "integer",
            "minimum": 1
          },
          "kvHeads": {
            "type": "integer",
            "minimum": 1
          },
          "seqLen": {
            "type": "integer",
            "minimum": 8,
            "maximum": 4096
          },
          "seed": {
            "type": "integer",
            "default": 1
          },
          "chars": {
            "type": "string",
            "minLength": 2,
            "description": "One token per character; must contain the space."
          }
        }
      },
      "timeoutMs": 600000
    },
    {
      "name": "intake",
      "title": "Read a llama2.c checkpoint and tokenizer into the Model IR (S1)",
      "inputs": [
        {
          "name": "weights",
          "types": [
            "model.weights.llama2c"
          ],
          "required": true
        },
        {
          "name": "tokenizer",
          "types": [
            "model.tokenizer.llama2c"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "ir",
          "type": "model.ir",
          "mediaType": "application/x-npz"
        },
        {
          "name": "structure",
          "type": "model.structure",
          "mediaType": "application/json"
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "license": {
            "type": "string"
          }
        }
      },
      "timeoutMs": 600000
    },
    {
      "name": "reference",
      "title": "L0 reference outputs and perplexity on an evaluation set",
      "inputs": [
        {
          "name": "ir",
          "types": [
            "model.ir"
          ],
          "required": true
        },
        {
          "name": "tokenizer",
          "types": [
            "model.tokenizer.llama2c"
          ],
          "required": true
        },
        {
          "name": "evalset",
          "types": [
            "eval.set"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "outputs",
          "type": "l0.outputs",
          "mediaType": "application/json"
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false
      },
      "timeoutMs": 1800000
    },
    {
      "name": "import",
      "title": "Import a model from this machine (path) or from a project's llama2.c weights, and take its tensor census (S0)",
      "outputs": [
        {
          "name": "file",
          "type": "model.file"
        },
        {
          "name": "bundle",
          "type": "model.bundle",
          "mediaType": "application/json"
        },
        {
          "name": "census",
          "type": "model.census",
          "mediaType": "application/json"
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "enum": [
              "public",
              "internal",
              "nda"
            ],
            "default": "internal"
          },
          "context": {
            "type": "integer",
            "minimum": 1,
            "default": 64
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "timeoutMs": 1800000,
      "inputs": [
        {
          "name": "weights",
          "types": [
            "model.weights.llama2c"
          ],
          "required": false
        },
        {
          "name": "tokenizer",
          "types": [
            "model.tokenizer.llama2c"
          ],
          "required": false
        }
      ]
    },
    {
      "name": "recover",
      "title": "Recover the computation graph from the census (S1)",
      "inputs": [
        {
          "name": "census",
          "types": [
            "model.census"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "graph",
          "type": "model.graph",
          "mediaType": "application/json"
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "timeoutMs": 600000
    },
    {
      "name": "run_graph",
      "title": "Run the recovered graph as the L0 reference on prompts (S1)",
      "inputs": [
        {
          "name": "graph",
          "types": [
            "model.graph"
          ],
          "required": true
        },
        {
          "name": "bundle",
          "types": [
            "model.bundle"
          ],
          "required": true
        },
        {
          "name": "files",
          "types": [
            "model.file",
            "model.weights.llama2c",
            "model.tokenizer.llama2c"
          ],
          "required": true,
          "multiple": true
        }
      ],
      "outputs": [
        {
          "name": "outputs",
          "type": "l0g.outputs",
          "mediaType": "application/json"
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 16
          },
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "default": 8
          }
        }
      },
      "timeoutMs": 3600000
    },
    {
      "name": "compare",
      "title": "Test the recovered graph against the official implementation, item by item (S1)",
      "inputs": [
        {
          "name": "graph",
          "types": [
            "model.graph"
          ],
          "required": true
        },
        {
          "name": "bundle",
          "types": [
            "model.bundle"
          ],
          "required": true
        },
        {
          "name": "files",
          "types": [
            "model.file",
            "model.weights.llama2c",
            "model.tokenizer.llama2c"
          ],
          "required": true,
          "multiple": true
        },
        {
          "name": "census",
          "types": [
            "model.census"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "report",
          "type": "upstream.report",
          "mediaType": "application/json"
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prompts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 16
          },
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "default": 8
          }
        }
      },
      "timeoutMs": 3600000
    }
  ],
  "data": [
    {
      "id": "evalset-proxy",
      "type": "eval.set",
      "path": "data/evalset-proxy.json",
      "label": "public"
    }
  ]
}
