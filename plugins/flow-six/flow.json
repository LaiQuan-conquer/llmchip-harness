{
  "id": "six",
  "version": "0.2.0",
  "stages": [
    {
      "id": "SPEC",
      "title": "Specification: model, numeric spec and L2, benchmarks",
      "develop": {
        "defaults": {
          "process-profile": "data:gf180mcu",
          "impl-library": "data:library-180nm"
        },
        "nodes": [
          {
            "id": "import",
            "plugin": "model-llama",
            "handler": "import",
            "params": {
              "name": "Qwen2.5-0.5B-Instruct"
            },
            "inputs": {
              "model": "slot:model"
            },
            "bind": {
              "census": "model-census"
            },
            "judge": [
              "model.census"
            ]
          },
          {
            "id": "recover",
            "plugin": "model-llama",
            "handler": "recover",
            "inputs": {
              "census": "node:import.census"
            },
            "bind": {
              "graph": "model-graph"
            },
            "judge": [
              "model.graph"
            ]
          },
          {
            "id": "upstream",
            "plugin": "model-llama",
            "handler": "compare",
            "inputs": {
              "graph": "node:recover.graph",
              "census": "node:import.census",
              "model": "slot:model"
            },
            "judge": [
              "model.upstream"
            ]
          },
          {
            "id": "calibrate",
            "plugin": "numeric",
            "handler": "calibrate_graph",
            "params": {
              "weightFormat": "int4",
              "groupSize": 128,
              "contextLength": 2048,
              "sequences": 64
            },
            "inputs": {
              "graph": "node:recover.graph",
              "calibration": "slot:calibration-data",
              "model": "slot:model"
            },
            "bind": {
              "spec": "numeric-spec",
              "weights": "l2-weights"
            }
          },
          {
            "id": "slice",
            "plugin": "arch-taalas",
            "handler": "slice",
            "params": {
              "level": "S-1"
            },
            "inputs": {
              "graph": "node:recover.graph",
              "spec": "node:calibrate.spec"
            },
            "bind": {
              "slice": "slice-definition"
            },
            "judge": [
              "spec.slice"
            ]
          },
          {
            "id": "design",
            "plugin": "arch-taalas",
            "handler": "design",
            "params": {
              "architecture": "taalas-tile/1",
              "macsPerEngine": 128,
              "engines": "per-layer",
              "clockMHz": 8,
              "weightStorage": "gf180mcu.stdcell-rom"
            },
            "inputs": {
              "spec": "node:calibrate.spec",
              "weights": "node:calibrate.weights",
              "profile": "slot:process-profile",
              "library": "slot:impl-library"
            },
            "bind": {
              "chip": "chip-spec",
              "ppa": "ppa-estimate"
            }
          },
          {
            "id": "verify",
            "plugin": "arch-taalas",
            "handler": "verify_spec",
            "inputs": {
              "chip": "node:design.chip"
            },
            "judge": [
              "spec.design"
            ]
          },
          {
            "id": "tlm",
            "plugin": "arch-taalas",
            "handler": "tlm",
            "params": {
              "tokens": [
                1,
                2,
                3,
                4,
                5,
                6,
                7,
                8
              ]
            },
            "inputs": {
              "chip": "node:design.chip",
              "graph": "node:recover.graph",
              "spec": "node:calibrate.spec",
              "weights": "node:calibrate.weights"
            },
            "judge": [
              "spec.tlm"
            ]
          },
          {
            "id": "l2-fast",
            "plugin": "numeric",
            "handler": "l2_fast_check",
            "inputs": {
              "data": "slot:benchmark-data",
              "graph": "node:recover.graph",
              "spec": "node:calibrate.spec",
              "weights": "node:calibrate.weights",
              "model": "slot:model"
            },
            "judge": [
              "spec.l2.fast"
            ]
          },
          {
            "id": "bench-l0",
            "plugin": "numeric",
            "handler": "benchmark",
            "params": {
              "layer": "L0",
              "set": "quick",
              "contextLength": 2048
            },
            "inputs": {
              "data": "slot:benchmark-data",
              "model": "slot:model"
            },
            "bind": {
              "report": "benchmark-l0-quick"
            }
          },
          {
            "id": "bench-l2",
            "plugin": "numeric",
            "handler": "benchmark",
            "params": {
              "layer": "L2",
              "set": "quick"
            },
            "inputs": {
              "data": "slot:benchmark-data",
              "graph": "node:recover.graph",
              "spec": "node:calibrate.spec",
              "weights": "node:calibrate.weights",
              "model": "slot:model"
            },
            "bind": {
              "report": "benchmark-l2-quick"
            }
          },
          {
            "id": "accuracy",
            "plugin": "numeric",
            "handler": "benchmark_compare",
            "inputs": {
              "l0": "node:bench-l0.report",
              "l2": "node:bench-l2.report"
            },
            "judge": [
              "spec.accuracy.quick.mmlu",
              "spec.accuracy.quick.cmmlu",
              "spec.accuracy.quick.ceval",
              "spec.accuracy.quick.gsm8k",
              "spec.accuracy.quick.ifeval",
              "spec.accuracy.quick.humaneval",
              "spec.accuracy.quick.mbpp"
            ]
          },
          {
            "id": "diagnose",
            "plugin": "numeric",
            "handler": "diagnose",
            "params": {
              "maxQuestions": 3,
              "steps": 32
            },
            "inputs": {
              "l0": "node:bench-l0.report",
              "l2": "node:bench-l2.report",
              "model": "slot:model",
              "graph": "node:recover.graph",
              "spec": "node:calibrate.spec",
              "weights": "node:calibrate.weights"
            },
            "judge": [
              "spec.diagnosis"
            ]
          }
        ]
      },
      "tests": [
        {
          "check": "model.upstream",
          "inputs": {
            "graph": "slot:model-graph",
            "census": "slot:model-census",
            "model": "slot:model"
          }
        },
        {
          "check": "spec.slice",
          "inputs": {
            "graph": "slot:model-graph",
            "spec": "slot:numeric-spec"
          }
        },
        {
          "check": "spec.design",
          "inputs": {
            "chip": "slot:chip-spec"
          }
        },
        {
          "check": "spec.tlm",
          "inputs": {
            "chip": "slot:chip-spec",
            "graph": "slot:model-graph",
            "spec": "slot:numeric-spec",
            "weights": "slot:l2-weights"
          },
          "params": {
            "tokens": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ]
          }
        },
        {
          "check": "spec.l2.fast",
          "inputs": {
            "data": "slot:benchmark-data",
            "graph": "slot:model-graph",
            "spec": "slot:numeric-spec",
            "weights": "slot:l2-weights",
            "model": "slot:model"
          }
        },
        {
          "check": "spec.accuracy.quick.mmlu",
          "inputs": {
            "l0": "slot:benchmark-l0-quick",
            "l2": "slot:benchmark-l2-quick"
          }
        },
        {
          "check": "spec.accuracy.quick.cmmlu",
          "inputs": {
            "l0": "slot:benchmark-l0-quick",
            "l2": "slot:benchmark-l2-quick"
          }
        },
        {
          "check": "spec.accuracy.quick.ceval",
          "inputs": {
            "l0": "slot:benchmark-l0-quick",
            "l2": "slot:benchmark-l2-quick"
          }
        },
        {
          "check": "spec.accuracy.quick.gsm8k",
          "inputs": {
            "l0": "slot:benchmark-l0-quick",
            "l2": "slot:benchmark-l2-quick"
          }
        },
        {
          "check": "spec.accuracy.quick.ifeval",
          "inputs": {
            "l0": "slot:benchmark-l0-quick",
            "l2": "slot:benchmark-l2-quick"
          }
        },
        {
          "check": "spec.accuracy.quick.humaneval",
          "inputs": {
            "l0": "slot:benchmark-l0-quick",
            "l2": "slot:benchmark-l2-quick"
          }
        },
        {
          "check": "spec.accuracy.quick.mbpp",
          "inputs": {
            "l0": "slot:benchmark-l0-quick",
            "l2": "slot:benchmark-l2-quick"
          }
        },
        {
          "check": "spec.diagnosis",
          "inputs": {
            "l0": "slot:benchmark-l0-quick",
            "l2": "slot:benchmark-l2-quick",
            "model": "slot:model",
            "graph": "slot:model-graph",
            "spec": "slot:numeric-spec",
            "weights": "slot:l2-weights"
          }
        }
      ]
    },
    {
      "id": "RTL",
      "title": "RTL: the taalas-tile/1 bundle of the slice, and its checks",
      "develop": {
        "nodes": [
          {
            "id": "generate",
            "plugin": "rtl-taalas",
            "handler": "tile_generate",
            "params": {
              "macsPerEngine": 128
            },
            "inputs": {
              "spec": "slot:numeric-spec",
              "weights": "slot:l2-weights",
              "slice": "slot:slice-definition"
            },
            "bind": {
              "rtl": "rtl-bundle",
              "manifest": "rtl-manifest"
            }
          },
          {
            "id": "check",
            "plugin": "rtl-taalas",
            "handler": "tile_check",
            "inputs": {
              "rtl": "node:generate.rtl"
            },
            "judge": [
              "rtl.tile.lint",
              "rtl.tile.synthesizable",
              "rtl.tile.roundtrip",
              "rtl.tile.rules",
              "rtl.tile.rom.views"
            ]
          }
        ]
      },
      "tests": [
        {
          "check": "rtl.tile.lint",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "rtl.tile.synthesizable",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "rtl.tile.roundtrip",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "rtl.tile.rules",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "rtl.tile.rom.views",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        }
      ]
    },
    {
      "id": "VER",
      "title": "Verification: the template suite, the functional S-1 slice and the clock domains",
      "develop": {
        "nodes": [
          {
            "id": "verify",
            "plugin": "rtl-taalas",
            "handler": "tile_verify",
            "inputs": {
              "rtl": "slot:rtl-bundle"
            },
            "judge": [
              "ver.unit",
              "ver.slice",
              "ver.cdc",
              "ver.layer",
              "ver.chain",
              "ver.directed",
              "ver.coverage",
              "ver.formal",
              "ver.mutation",
              "ver.dft",
              "rtl.tile.equivalence"
            ]
          }
        ]
      },
      "tests": [
        {
          "check": "ver.unit",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "ver.slice",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "ver.cdc",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "ver.layer",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "ver.chain",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "ver.directed",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "ver.coverage",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "ver.formal",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "ver.mutation",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "ver.dft",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        },
        {
          "check": "rtl.tile.equivalence",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          }
        }
      ]
    },
    {
      "id": "SYN",
      "title": "Synthesis and DFT: the S-1 slice on sky130, GF180MCU and IHP SG13G2",
      "develop": {
        "nodes": [
          {
            "id": "synth-sky130",
            "plugin": "syn-yosys",
            "handler": "synth",
            "params": {
              "pdk": "sky130"
            },
            "inputs": {
              "rtl": "slot:rtl-bundle"
            },
            "judge": [
              "syn.synth.sky130"
            ]
          },
          {
            "id": "dft-sky130",
            "plugin": "syn-yosys",
            "handler": "dft",
            "params": {
              "pdk": "sky130"
            },
            "inputs": {
              "rtl": "slot:rtl-bundle"
            },
            "judge": [
              "syn.dft.scan.sky130"
            ]
          }
        ]
      },
      "tests": [
        {
          "check": "syn.synth.sky130",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "sky130"
          }
        },
        {
          "check": "syn.synth.gf180mcuD",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "gf180mcuD"
          }
        },
        {
          "check": "syn.synth.ihp-sg13g2",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "ihp-sg13g2"
          }
        },
        {
          "check": "syn.dft.scan.sky130",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "sky130"
          }
        },
        {
          "check": "syn.dft.scan.gf180mcuD",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "gf180mcuD"
          }
        },
        {
          "check": "syn.dft.scan.ihp-sg13g2",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "ihp-sg13g2"
          }
        },
        {
          "check": "syn.timing.sky130",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "sky130",
            "period": 100
          }
        },
        {
          "check": "syn.timing.gf180mcuD",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "gf180mcuD",
            "period": 100
          }
        },
        {
          "check": "syn.timing.ihp-sg13g2",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "ihp-sg13g2",
            "period": 100
          }
        },
        {
          "check": "syn.dft.atpg.sky130",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "sky130"
          }
        },
        {
          "check": "syn.dft.atpg.gf180mcuD",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "gf180mcuD"
          }
        },
        {
          "check": "syn.dft.atpg.ihp-sg13g2",
          "inputs": {
            "rtl": "slot:rtl-bundle"
          },
          "params": {
            "pdk": "ihp-sg13g2"
          }
        }
      ]
    }
  ],
  "checks": [
    {
      "id": "ver.unit",
      "version": "1",
      "title": "The template suite (engine, attention, Q-full chain, ROM views, macro) passes",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_unit_tests",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "ver_unit",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "id": "ver.slice",
      "version": "1",
      "title": "The functional S-1 q_proj slice equals GraphL2's observation on the test vectors",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_slice_tests",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "ver_slice",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "id": "ver.cdc",
      "version": "1",
      "title": "The datapath stays in the clk domain; host_sclk is the documented second domain",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_cdc_domains",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "ver_cdc",
          "op": "==",
          "value": 1
        },
        {
          "metric": "ver_cdc_violations",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "ver.layer",
      "version": "1",
      "title": "Both Q-full layers match GraphL2 at every observation point",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_layer_layers",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "ver_layer",
          "op": "==",
          "value": 1
        },
        {
          "metric": "ver_layer_observations",
          "op": ">",
          "value": 0
        }
      ]
    },
    {
      "id": "ver.chain",
      "version": "1",
      "title": "The Q-full layer chain, one tile_layer per layer chained by the residual handshake, matches GraphL2 at 16 and 24 bits",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_chain_cases",
          "op": ">=",
          "value": 2
        }
      ],
      "criteria": [
        {
          "metric": "ver_chain",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "id": "ver.directed",
      "version": "1",
      "title": "Directed tests: power-on, start while busy, host frames, reset mid-inference, one token, context boundary",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_directed_cases",
          "op": ">=",
          "value": 3
        }
      ],
      "criteria": [
        {
          "metric": "ver_directed",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "id": "ver.coverage",
      "version": "1",
      "title": "The chained layer harness keeps line coverage at or above 90%",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_coverage_line",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "ver_coverage",
          "op": "==",
          "value": 1
        },
        {
          "metric": "ver_coverage_line",
          "op": ">=",
          "value": 90
        }
      ]
    },
    {
      "id": "ver.formal",
      "version": "1",
      "title": "The residual add satisfies its saturating-sum property in BMC",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_formal_tests",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "ver_formal",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "id": "ver.mutation",
      "version": "1",
      "title": "The residual mutation score is at least 95% with equivalence-classified survivors",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_mutation_score",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "ver_mutation",
          "op": "==",
          "value": 1
        },
        {
          "metric": "ver_mutation_score",
          "op": ">=",
          "value": 95
        }
      ]
    },
    {
      "id": "ver.dft",
      "version": "1",
      "title": "DFT readiness audit: reset, two clock domains, no latches, ROM-only initial blocks",
      "plugin": "rtl-taalas",
      "handler": "tile_verify",
      "completeness": [
        {
          "metric": "ver_dft_tests",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "ver_dft",
          "op": "==",
          "value": 1
        }
      ]
    },
    {
      "id": "model.census",
      "version": "1",
      "title": "Tensor census of the imported weights is self-consistent",
      "plugin": "model-llama",
      "handler": "import",
      "completeness": [
        {
          "metric": "tensors",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "all_tensors_classified",
          "op": "==",
          "value": true
        },
        {
          "metric": "header_consistent",
          "op": "==",
          "value": true
        },
        {
          "metric": "layers_uniform",
          "op": "==",
          "value": true
        },
        {
          "metric": "config_agrees",
          "op": "==",
          "value": true
        },
        {
          "metric": "output_consistent",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "model.graph",
      "version": "1",
      "title": "Computation graph recovered with every tensor bound",
      "plugin": "model-llama",
      "handler": "recover",
      "criteria": [
        {
          "metric": "family_supported",
          "op": "==",
          "value": true
        },
        {
          "metric": "tensors_unmatched",
          "op": "==",
          "value": 0
        },
        {
          "metric": "tensors_missing",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "model.upstream",
      "version": "2",
