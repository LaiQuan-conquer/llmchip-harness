{
  "id": "arch-taalas",
  "version": "0.2.0",
  "title": "Taalas-style hardwired architecture template (S3)",
  "kinds": [
    "architecture"
  ],
  "runtime": "process",
  "entry": {
    "command": [
      "${python}",
      "-m",
      "llmchip_arch"
    ]
  },
  "kernelApi": "^0.3",
  "requiresProcessCapabilities": [
    "stdcell-logic",
    "io-pads",
    "storage:<weightStorage>"
  ],
  "handlers": [
    {
      "name": "design",
      "title": "Chip spec and PPA estimate from a frozen numeric spec",
      "inputs": [
        {
          "name": "spec",
          "types": [
            "numeric.spec"
          ],
          "required": true
        },
        {
          "name": "weights",
          "types": [
            "numeric.weights"
          ],
          "required": true
        },
        {
          "name": "profile",
          "types": [
            "process.profile"
          ],
          "required": true
        },
        {
          "name": "library",
          "types": [
            "implementation.library"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "chip",
          "type": "chip.spec",
          "mediaType": "application/json"
        },
        {
          "name": "ppa",
          "type": "ppa.estimate",
          "mediaType": "application/json"
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "weightStorage"
        ],
        "properties": {
          "weightStorage": {
            "type": "string"
          },
          "kvStorage": {
            "type": "string"
          },
          "kvLocation": {
            "enum": [
              "offchip",
              "onchip"
            ],
            "default": "offchip"
          },
          "parallelMacs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096,
            "default": 8
          },
          "memoryInterface": {
            "enum": [
              "spi",
              "sqi"
            ],
            "default": "spi",
            "description": "External SRAM interface of the engine: SPI (1 data line in, 1 out) or quad SPI (4 bidirectional lines)."
          },
          "operandBuffers": {
            "enum": [
              "none",
              "attention",
              "all"
            ],
            "default": "none",
            "description": "On-chip operand buffers: none; attention (the head's q and the output accumulators); all (also the MATVEC / RMS vector)."
          },
          "clockMHz": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 50
          },
          "offchipBandwidthMBps": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 25
          },
          "targetAreaMm2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "activationLocation": {
            "enum": [
              "offchip",
              "onchip"
            ],
            "default": "offchip",
            "description": "Where the engine keeps its working data; the rtl-taalas generator implements offchip."
          },
          "die": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "xMm",
              "yMm"
            ],
            "properties": {
              "xMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "yMm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "description": "Die size chosen within the foundry's size rules (S6 uses it)."
          },
          "architecture": {
            "enum": [
              "taalas-hardwired/0.2",
              "taalas-spatial/1"
            ],
            "default": "taalas-hardwired/0.2",
            "description": "Architecture template: the microcoded vector engine with an external memory, or the spatial engine (every matrix a circuit, KV cache on chip)."
          },
          "cyclesPerToken": {
            "type": "integer",
            "minimum": 1,
            "description": "Speed target: cycles per token at the last position; arch.spec judges it when it is set (cycles_within_target)."
          },
          "dividers": {
            "enum": [
              4,
              8,
              16,
              32,
              64
            ],
            "default": 16,
            "description": "Spatial engine: exact serial dividers of the softmax (fewer: smaller, slower)."
          }
        }
      },
      "timeoutMs": 600000
    },
    {
      "name": "verify_spec",
      "title": "Chip spec consistency with the numeric spec and the area limit (S3 evidence)",
      "inputs": [
        {
          "name": "chip",
          "types": [
            "chip.spec"
          ],
          "required": true
        },
        {
          "name": "spec",
          "types": [
            "numeric.spec"
          ],
          "required": true
        },
        {
          "name": "ppa",
          "types": [
            "ppa.estimate"
          ],
          "required": true
        },
        {
          "name": "weights",
          "types": [
            "numeric.weights"
          ],
          "required": false
        }
      ],
      "outputs": [],
      "params": {
        "type": "object",
        "additionalProperties": false
      },
      "timeoutMs": 60000
    },
    {
      "name": "explore",
      "title": "Design-space exploration: exact cycles and area of every point, Pareto front (also the analysis of an imported model)",
      "inputs": [
        {
          "name": "spec",
          "types": [
            "numeric.spec"
          ],
          "required": true
        },
        {
          "name": "weights",
          "types": [
            "numeric.weights"
          ],
          "required": true
        },
        {
          "name": "profile",
          "types": [
            "process.profile"
          ],
          "required": true
        },
        {
          "name": "library",
          "types": [
            "implementation.library"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "exploration",
          "type": "arch.exploration",
          "mediaType": "application/json"
        }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "weightStorage"
        ],
        "properties": {
          "weightStorage": {
            "type": "string"
          },
          "kvStorage": {
            "type": "string"
          },
          "kvLocation": {
            "enum": [
              "offchip",
              "onchip"
            ],
            "default": "offchip"
          },
          "parallelMacs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096,
            "default": 8
          },
          "memoryInterface": {
            "enum": [
              "spi",
              "sqi"
            ],
            "default": "spi",
            "description": "External SRAM interface of the engine: SPI (1 data line in, 1 out) or quad SPI (4 bidirectional lines)."
          },
          "operandBuffers": {
            "enum": [
              "none",
              "attention",
              "all"
            ],
            "default": "none",
            "description": "On-chip operand buffers: none; attention (the head's q and the output accumulators); all (also the MATVEC / RMS vector)."
          },
          "clockMHz": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 50
          },
          "offchipBandwidthMBps": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 25
          },
          "targetAreaMm2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "activationLocation": {
            "enum": [
              "offchip",
              "onchip"
            ],
            "default": "offchip",
            "description": "Where the engine keeps its working data; the rtl-taalas generator implements offchip."
          },
          "die": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "xMm",
              "yMm"
            ],
            "properties": {
              "xMm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "yMm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "description": "Die size chosen within the foundry's size rules (S6 uses it)."
          },
          "lanesOptions": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "minItems": 1,
            "maxItems": 8
          },
          "memoryInterfaces": {
            "type": "array",
            "items": {
              "enum": [
                "spi",
                "sqi"
              ]
            },
            "minItems": 1,
            "maxItems": 2
          },
          "operandBuffersOptions": {
            "type": "array",
            "items": {
              "enum": [
                "none",
                "attention",
                "all"
              ]
            },
            "minItems": 1,
            "maxItems": 3
          },
          "clocksMHz": {
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minItems": 1,
            "maxItems": 6
          },
          "architecture": {
            "enum": [
              "taalas-hardwired/0.2",
              "taalas-spatial/1"
            ],
            "default": "taalas-hardwired/0.2",
            "description": "Architecture template: the microcoded vector engine with an external memory, or the spatial engine (every matrix a circuit, KV cache on chip)."
          },
          "dividers": {
            "enum": [
              4,
              8,
              16,
              32,
              64
            ],
            "default": 16,
            "description": "Spatial engine: exact serial dividers of the softmax (fewer: smaller, slower)."
          },
          "dividersOptions": {
            "type": "array",
            "items": {
              "enum": [
                4,
                8,
                16,
                32,
                64
              ]
            },
            "minItems": 1,
            "description": "Spatial engine: the divider counts to explore."
          }
        }
      },
      "timeoutMs": 3600000
    },
    {
      "name": "slice",
      "title": "The slice of layer 0 at a level of the plan: matrices, group alignment, L2 observation points",
      "inputs": [
        { "name": "graph", "types": ["model.graph"], "required": true },
        { "name": "spec", "types": ["numeric.spec"], "required": true }
      ],
      "outputs": [{ "name": "slice", "type": "arch.slice", "mediaType": "application/json" }],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "level": { "enum": ["S-1", "S-2", "S-3"], "default": "S-1" },
          "layer": { "type": "integer", "minimum": 0, "default": 0 },
          "channels": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 128 }
        }
      },
      "timeoutMs": 600000
    }
  ]
}
