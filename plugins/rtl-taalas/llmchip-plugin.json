{
  "id": "rtl-taalas",
  "version": "0.1.0",
  "title": "RTL generator for the Taalas-style vector engine (S4)",
  "kinds": ["rtl-generator"],
  "runtime": "process",
  "entry": { "command": ["${python}", "-m", "llmchip_rtl"] },
  "kernelApi": "^0.3",
  "handlers": [
    {
      "name": "generate",
      "title": "RTL bundle (vector engine, ROM images, microcode, testbench) and storage map",
      "inputs": [
        { "name": "spec", "types": ["numeric.spec"], "required": true },
        { "name": "weights", "types": ["numeric.weights"], "required": true },
        { "name": "chip", "types": ["chip.spec"], "required": true }
      ],
      "outputs": [
        { "name": "rtl", "type": "rtl.bundle", "mediaType": "application/x-tar" },
        { "name": "storage", "type": "storage.map", "mediaType": "application/json" }
      ],
      "params": { "type": "object", "additionalProperties": false },
      "timeoutMs": 1800000
    },
    {
      "name": "check_isa",
      "title": "Compiler verification: the generated program on the instruction-level simulator equals L2",
      "inputs": [
        { "name": "rtl", "types": ["rtl.bundle"], "required": true },
        { "name": "spec", "types": ["numeric.spec"], "required": true },
        { "name": "weights", "types": ["numeric.weights"], "required": true },
        { "name": "tokenizer", "types": ["model.tokenizer.llama2c"], "required": true },
        { "name": "evalset", "types": ["eval.set"], "required": true }
      ],
      "outputs": [{ "name": "report", "type": "isa.check", "mediaType": "application/json" }],
      "params": { "type": "object", "additionalProperties": false },
      "timeoutMs": 3600000
    },
    {
      "name": "tile_generate",
      "title": "The taalas-tile/1 RTL bundle of a slice: templates, view-1 ROM contents, manifest",
      "inputs": [
        { "name": "spec", "types": ["numeric.spec"], "required": true },
        { "name": "weights", "types": ["numeric.weights"], "required": true },
        { "name": "slice", "types": ["arch.slice"], "required": true }
      ],
      "outputs": [
        { "name": "rtl", "type": "rtl.bundle", "mediaType": "application/x-tar" },
        { "name": "manifest", "type": "rtl.manifest", "mediaType": "application/json" }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "macsPerEngine": { "type": "integer", "minimum": 1, "maximum": 4096, "default": 128 } }
      },
      "timeoutMs": 1800000
    },
    {
      "name": "tile_verify",
      "title": "R4 verification: template suite, functional S-1 slice and clock domains",
      "inputs": [
        { "name": "rtl", "types": ["rtl.bundle"], "required": true },
        { "name": "model", "types": ["model.archive"], "required": false }
      ],
      "outputs": [{ "name": "report", "type": "verification.report", "mediaType": "application/json" }],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit": { "type": "boolean", "default": true },
          "slice": { "type": "boolean", "default": true }
        }
      },
      "timeoutMs": 3600000
    },
    {
      "name": "tile_check",
      "title": "The RTL checks of a tile bundle: ROM round trip, rules, Verilator lint, Yosys",
      "inputs": [{ "name": "rtl", "types": ["rtl.bundle"], "required": true }],
      "outputs": [{ "name": "report", "type": "rtl.checks", "mediaType": "application/json" }],
      "params": { "type": "object", "additionalProperties": false },
      "timeoutMs": 3600000
    }
  ]
}
