{
  "id": "numeric",
  "version": "0.3.0",
  "title": "Numeric co-design: quantization, numeric spec, L2 bit-exact model, accuracy, benchmarks (S2)",
  "kinds": ["quantizer", "numeric-spec"],
  "runtime": "process",
  "entry": { "command": ["${python}", "-m", "llmchip_numeric"] },
  "kernelApi": "^0.3",
  "data": [
    { "id": "evalset-tinystories", "type": "eval.set", "path": "data/evalset-tinystories.json", "label": "public" },
    { "id": "evalset-general", "type": "eval.set", "path": "data/evalset-general.json", "label": "public" },
    { "id": "benchmark-reference", "type": "benchmark.reference", "path": "data/benchmark-reference.json", "label": "public" }
  ],
  "handlers": [
    {
      "name": "quantize",
      "title": "Quantize the model and write its numeric spec",
      "inputs": [
        { "name": "ir", "types": ["model.ir"], "required": true },
        { "name": "tokenizer", "types": ["model.tokenizer.llama2c"], "required": true },
        { "name": "evalset", "types": ["eval.set"], "required": true }
      ],
      "outputs": [
        { "name": "spec", "type": "numeric.spec", "mediaType": "application/json" },
        { "name": "weights", "type": "numeric.weights", "mediaType": "application/x-npz" }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "weightFormat": { "enum": ["int8", "int4", "int3", "ternary"], "default": "int4" },
          "groupSize": { "type": "integer", "minimum": 4, "maximum": 4096, "default": 32 },
          "contextLength": { "type": "integer", "minimum": 8, "maximum": 4096, "default": 64 },
          "rounding": { "enum": ["half-up", "half-even", "truncate"], "default": "half-up" },
          "overflow": { "enum": ["saturate", "wrap"], "default": "saturate" },
          "accumulatorBits": { "type": "integer", "minimum": 16, "maximum": 64 }
        }
      },
      "timeoutMs": 1800000
    },
    {
      "name": "infer",
      "title": "L2 generations with observation-point traces",
      "inputs": [
        { "name": "spec", "types": ["numeric.spec"], "required": true },
        { "name": "weights", "types": ["numeric.weights"], "required": true },
        { "name": "tokenizer", "types": ["model.tokenizer.llama2c"], "required": true },
        { "name": "evalset", "types": ["eval.set"], "required": true }
      ],
      "outputs": [
        { "name": "outputs", "type": "l2.outputs", "mediaType": "application/json" },
        { "name": "trace", "type": "l2.trace", "mediaType": "application/x-npz" }
      ],
      "params": { "type": "object", "additionalProperties": false },
      "timeoutMs": 3600000
    },
    {
      "name": "evaluate",
      "title": "Accuracy of L2 against L0 (S2 evidence)",
      "inputs": [
        { "name": "ir", "types": ["model.ir"], "required": true },
        { "name": "tokenizer", "types": ["model.tokenizer.llama2c"], "required": true },
        { "name": "evalset", "types": ["eval.set"], "required": true },
        { "name": "spec", "types": ["numeric.spec"], "required": true },
        { "name": "weights", "types": ["numeric.weights"], "required": true }
      ],
      "outputs": [{ "name": "report", "type": "accuracy.report", "mediaType": "application/json" }],
      "params": { "type": "object", "additionalProperties": false },
      "timeoutMs": 3600000
    },
    {
      "name": "quantize_graph",
      "title": "Quantize a recovered graph (any model) and write its numeric spec (analysis)",
      "inputs": [
        { "name": "graph", "types": ["model.graph"], "required": true },
        { "name": "model", "types": ["model.archive"], "required": false },
        { "name": "bundle", "types": ["model.bundle"], "required": false },
        { "name": "files", "types": ["model.file", "model.weights.llama2c", "model.tokenizer.llama2c"], "required": false, "multiple": true },
        { "name": "evalset", "types": ["eval.set"], "required": false }
      ],
      "outputs": [
        { "name": "spec", "type": "numeric.spec", "mediaType": "application/json" },
        { "name": "weights", "type": "numeric.weights", "mediaType": "application/x-npz" }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "weightFormat": { "enum": ["int8", "int4", "int3", "ternary"], "default": "int8" },
          "groupSize": { "type": "integer", "minimum": 4, "maximum": 256, "default": 32 },
          "contextLength": { "type": "integer", "minimum": 16, "maximum": 4096, "default": 256 },
          "perLayer": { "type": "boolean", "default": true },
          "residualBits": { "enum": [16, 24], "default": 24 },
          "rounding": { "enum": ["half-up", "half-even", "truncate"], "default": "half-up" },
          "overflow": { "enum": ["saturate", "wrap"], "default": "saturate" },
          "accumulatorBits": { "type": "integer", "minimum": 16, "maximum": 64 }
        }
      },
      "timeoutMs": 3600000
    },
    {
      "name": "diagnose",
      "title": "Why L2 answers differently from L0: first divergent token, per-layer deviation, its layer",
      "inputs": [
        { "name": "l0", "types": ["benchmark.report"], "required": true },
        { "name": "l2", "types": ["benchmark.report"], "required": true },
        { "name": "graph", "types": ["model.graph"], "required": true },
        { "name": "spec", "types": ["numeric.spec"], "required": true },
        { "name": "weights", "types": ["numeric.weights"], "required": true },
        { "name": "model", "types": ["model.archive"], "required": false },
        { "name": "bundle", "types": ["model.bundle"], "required": false },
        { "name": "files", "types": ["model.file"], "required": false, "multiple": true }
      ],
      "outputs": [{ "name": "report", "type": "diagnosis.report", "mediaType": "application/json" }],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxQuestions": { "type": "integer", "minimum": 1, "maximum": 32, "default": 3 },
          "steps": { "type": "integer", "minimum": 1, "maximum": 256, "default": 32 }
        }
      },
      "resources": { "cpu": 4, "memGb": 8, "gpu": 1 },
      "timeoutMs": 7200000
    },
    {
      "name": "calibration_data",
      "title": "Pack the calibration text of this machine (WikiText-2) into one artifact (GPTQ)",
      "inputs": [],
      "outputs": [{ "name": "calibration", "type": "calibration.data", "mediaType": "application/json" }],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": { "path": { "type": "string", "minLength": 1 } }
      },
      "timeoutMs": 1800000
    },
    {
      "name": "calibrate_graph",
      "title": "Calibrated (GPTQ) quantization of a recovered graph: numeric spec and integer weights",
      "inputs": [
        { "name": "graph", "types": ["model.graph"], "required": true },
        { "name": "calibration", "types": ["calibration.data"], "required": true },
        { "name": "model", "types": ["model.archive"], "required": false },
        { "name": "bundle", "types": ["model.bundle"], "required": false },
        { "name": "files", "types": ["model.file", "model.weights.llama2c", "model.tokenizer.llama2c"], "required": false, "multiple": true }
      ],
      "outputs": [
        { "name": "spec", "type": "numeric.spec", "mediaType": "application/json" },
        { "name": "weights", "type": "numeric.weights", "mediaType": "application/x-npz" }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "weightFormat": { "enum": ["int8", "int4", "int3", "ternary"], "default": "int4" },
          "groupSize": { "type": "integer", "minimum": 4, "maximum": 256, "default": 128 },
          "contextLength": { "type": "integer", "minimum": 16, "maximum": 4096, "default": 2048 },
          "sequences": { "type": "integer", "minimum": 1, "maximum": 512, "default": 64 },
          "batchSize": { "type": "integer", "minimum": 1, "maximum": 32, "default": 8 },
          "overrides": { "type": "object", "additionalProperties": { "enum": ["int8", "int4", "int3", "ternary"] } }
        }
      },
      "resources": { "cpu": 4, "memGb": 16, "gpu": 1 },
      "timeoutMs": 10800000
    },
    {
      "name": "evaluate_graph",
      "title": "Accuracy of a recovered graph's L2 against L0 (analysis)",
      "inputs": [
        { "name": "graph", "types": ["model.graph"], "required": true },
        { "name": "model", "types": ["model.archive"], "required": false },
        { "name": "bundle", "types": ["model.bundle"], "required": false },
        { "name": "files", "types": ["model.file", "model.weights.llama2c", "model.tokenizer.llama2c"], "required": false, "multiple": true },
        { "name": "evalset", "types": ["eval.set"], "required": false },
        { "name": "spec", "types": ["numeric.spec"], "required": true },
        { "name": "weights", "types": ["numeric.weights"], "required": true }
      ],
      "outputs": [{ "name": "report", "type": "accuracy.report", "mediaType": "application/json" }],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxPrompts": { "type": "integer", "minimum": 1, "maximum": 20, "default": 4 },
          "steps": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8 },
          "passageTokens": { "type": "integer", "minimum": 8, "maximum": 1024, "default": 128 }
        }
      },
      "timeoutMs": 7200000
    },
    {
      "name": "benchmark_data",
      "title": "Pack the open benchmarks downloaded on this machine, with the quick set",
      "inputs": [],
      "outputs": [
        { "name": "data", "type": "benchmark.data", "mediaType": "application/x-tar" },
        { "name": "sets", "type": "benchmark.sets", "mediaType": "application/json" }
      ],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Directory with hf/, datasets/cmmlu, datasets/evalplus and nltk_data (the layout of the workbench tools directory)"
          }
        }
      },
      "timeoutMs": 1800000
    },
    {
      "name": "benchmark",
      "title": "Answer the benchmark questions with L0 or L2 (model quality, FR-QNT-04)",
      "inputs": [
        { "name": "data", "types": ["benchmark.data"], "required": true },
        { "name": "model", "types": ["model.archive"], "required": false },
        { "name": "bundle", "types": ["model.bundle"], "required": false },
        { "name": "files", "types": ["model.file"], "required": false, "multiple": true },
        { "name": "graph", "types": ["model.graph"], "required": false },
        { "name": "spec", "types": ["numeric.spec"], "required": false },
        { "name": "weights", "types": ["numeric.weights"], "required": false },
        { "name": "resume", "types": ["run.checkpoint"], "required": false }
      ],
      "outputs": [{ "name": "report", "type": "benchmark.report", "mediaType": "application/json" }],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer"],
        "properties": {
          "layer": { "enum": ["L0", "L2"] },
          "set": { "enum": ["quick", "full"], "default": "quick" },
          "benchmarks": {
            "type": "array",
            "items": { "enum": ["mmlu", "cmmlu", "ceval", "gsm8k", "ifeval", "humaneval", "mbpp"] },
            "minItems": 1,
            "uniqueItems": true
          },
          "batchSize": { "type": "integer", "minimum": 1, "maximum": 256, "default": 32 },
          "contextLength": { "type": "integer", "minimum": 256, "maximum": 32768 }
        }
      },
      "resources": { "cpu": 4, "memGb": 8, "gpu": 1 },
      "timeoutMs": 43200000
    },
    {
      "name": "benchmark_compare",
      "title": "L2 against L0 on the same questions: drop and 95% interval per benchmark",
      "inputs": [{ "name": "l0", "types": ["benchmark.report"], "required": true }, { "name": "l2", "types": ["benchmark.report"], "required": true }],
      "outputs": [{ "name": "comparison", "type": "benchmark.comparison", "mediaType": "application/json" }],
      "params": { "type": "object", "additionalProperties": false },
      "timeoutMs": 600000
    },
    {
      "name": "l2_fast_check",
      "title": "The fast L2 (GPU) against the reference L2, bit for bit (spec.l2.fast)",
      "inputs": [
        { "name": "data", "types": ["benchmark.data"], "required": true },
        { "name": "model", "types": ["model.archive"], "required": false },
        { "name": "bundle", "types": ["model.bundle"], "required": false },
        { "name": "files", "types": ["model.file"], "required": false, "multiple": true },
        { "name": "graph", "types": ["model.graph"], "required": true },
        { "name": "spec", "types": ["numeric.spec"], "required": true },
        { "name": "weights", "types": ["numeric.weights"], "required": true }
      ],
      "outputs": [{ "name": "report", "type": "l2.fast-check", "mediaType": "application/json" }],
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "steps": { "type": "integer", "minimum": 1, "maximum": 512, "default": 64 } }
      },
      "resources": { "cpu": 4, "memGb": 8, "gpu": 1 },
      "timeoutMs": 7200000
    }
  ]
}
