{
  "id": "default",
  "version": "0.3.0",
  "stages": [
    {
      "id": "S0",
      "title": "Feasibility and cost estimate"
    },
    {
      "id": "S1",
      "title": "Model intake",
      "entry": {
        "gates": [
          "G0"
        ]
      }
    },
    {
      "id": "S2",
      "title": "Numeric co-design",
      "entry": {
        "gates": [
          "G0"
        ]
      }
    },
    {
      "id": "S3",
      "title": "Architecture design and exploration",
      "entry": {
        "gates": [
          "G1"
        ]
      }
    },
    {
      "id": "S4",
      "title": "Hardware generation",
      "entry": {
        "gates": [
          "G2"
        ],
        "checks": [
          {
            "check": "impl.views.S4",
            "slot": "storage-impl"
          }
        ]
      }
    },
    {
      "id": "S5",
      "title": "Functional verification",
      "entry": {
        "gates": [
          "G2"
        ]
      }
    },
    {
      "id": "S6",
      "title": "Physical implementation",
      "entry": {
        "gates": [
          "G3"
        ],
        "checks": [
          {
            "check": "impl.views.S6",
            "slot": "storage-impl"
          }
        ]
      }
    },
    {
      "id": "S7",
      "title": "Signoff",
      "entry": {
        "gates": [
          "G3"
        ],
        "checks": [
          {
            "check": "impl.views.S7",
            "slot": "storage-impl"
          }
        ]
      }
    },
    {
      "id": "S8",
      "title": "Tapeout package",
      "entry": {
        "gates": [
          "G3"
        ]
      }
    },
    {
      "id": "S9",
      "title": "Post-silicon test",
      "entry": {
        "gates": [
          "G4"
        ]
      }
    }
  ],
  "gates": [
    {
      "id": "G0",
      "title": "Project initiation",
      "after": "S0",
      "members": [
        "charter",
        "estimate-request",
        "process-profile",
        "impl-library"
      ],
      "checks": [
        "estimate.feasibility"
      ]
    },
    {
      "id": "G1",
      "title": "Accuracy signoff",
      "after": "S2",
      "members": [
        "model-ir",
        "tokenizer",
        "eval-set",
        "numeric-spec",
        "l2-weights"
      ],
      "checks": [
        "accuracy.budget"
      ]
    },
    {
      "id": "G2",
      "title": "Architecture freeze",
      "after": "S3",
      "members": [
        "numeric-spec",
        "chip-spec",
        "ppa-estimate"
      ],
      "checks": [
        "arch.spec"
      ]
    },
    {
      "id": "G3",
      "title": "RTL freeze",
      "after": "S5",
      "members": [
        "numeric-spec",
        "rtl",
        "l2-trace",
        "verification-plan"
      ],
      "checks": [
        "rtl.lint",
        "rtl.equivalence"
      ]
    },
    {
      "id": "G4",
      "title": "Tapeout signoff",
      "after": "S8",
      "members": [
        "gds",
        "signoff-checklist",
        "tapeout-package"
      ],
      "checks": []
    }
  ],
  "checks": [
    {
      "id": "estimate.feasibility",
      "version": "1",
      "title": "Feasibility estimate is feasible or conditionally feasible",
      "plugin": "estimator",
      "handler": "estimate",
      "completeness": [
        {
          "metric": "missing_count",
          "op": "==",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "feasible_or_conditional",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "impl.views.S4",
      "version": "1",
      "title": "Storage implementation has the integration views S4 needs",
      "plugin": "estimator",
      "handler": "check_views",
      "criteria": [
        {
          "metric": "views.S4.complete",
          "op": "==",
          "value": true
        },
        {
          "metric": "available",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "impl.views.S6",
      "version": "1",
      "title": "Storage implementation has the integration views S6 needs",
      "plugin": "estimator",
      "handler": "check_views",
      "criteria": [
        {
          "metric": "views.S6.complete",
          "op": "==",
          "value": true
        },
        {
          "metric": "available",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "impl.views.S7",
      "version": "1",
      "title": "Storage implementation has the integration views S7 needs",
      "plugin": "estimator",
      "handler": "check_views",
      "criteria": [
        {
          "metric": "views.S7.complete",
          "op": "==",
          "value": true
        },
        {
          "metric": "available",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "accuracy.budget",
      "version": "1",
      "title": "L2 accuracy against L0 within the budget (G1)",
      "plugin": "numeric",
      "handler": "evaluate",
      "completeness": [
        {
          "metric": "prompts_evaluated",
          "op": ">=",
          "value": 20
        },
        {
          "metric": "tokens_per_prompt",
          "op": ">=",
          "value": 64
        },
        {
          "metric": "passage_tokens",
          "op": ">=",
          "value": 100
        }
      ],
      "criteria": [
        {
          "metric": "ppl_increase_pct",
          "op": "<=",
          "value": 20
        }
      ],
      "waiver": "risk_acceptance"
    },
    {
      "id": "arch.spec",
      "version": "1",
      "title": "Chip spec follows the frozen numeric spec, covers every observation point and fits the area (G2)",
      "plugin": "arch-taalas",
      "handler": "verify_spec",
      "criteria": [
        {
          "metric": "numeric_spec_matches",
          "op": "==",
          "value": true
        },
        {
          "metric": "observation_points_covered",
          "op": "==",
          "value": true
        },
        {
          "metric": "fits_area",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "rtl.lint",
      "version": "1",
      "title": "Generated RTL is lint-clean (FR-RTL-03)",
      "plugin": "sim-verilator",
      "handler": "lint",
      "criteria": [
        {
          "metric": "lint_errors",
          "op": "==",
          "value": 0
        },
        {
          "metric": "lint_warnings",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "rtl.equivalence",
      "version": "1",
      "title": "Every item of the verification plan executed; L3 equals L2 bit for bit; coverage reaches the threshold (G3, AC-03)",
      "plugin": "sim-verilator",
      "handler": "verify",
      "requiredCapability": "rtl-functional-sim",
      "completeness": [
        {
          "metric": "items_not_executed",
          "op": "==",
          "value": 0
        },
        {
          "metric": "regression_prompts",
          "op": ">=",
          "value": 20
        },
        {
          "metric": "tokens_per_prompt",
          "op": ">=",
          "value": 64
        }
      ],
      "criteria": [
        {
          "metric": "items_failed",
          "op": "==",
          "value": 0
        },
        {
          "metric": "regression_mismatches",
          "op": "==",
          "value": 0
        },
        {
          "metric": "random_mismatches",
          "op": "==",
          "value": 0
        },
        {
          "metric": "coverage_line_pct",
          "op": ">=",
          "value": 90
        }
      ]
    },
    {
      "id": "sim-verilator.qualify.rtl-functional-sim",
      "version": "1",
      "title": "Qualification of the RTL functional simulation capability (FR-VER-01)",
      "plugin": "sim-verilator",
      "handler": "qualify",
      "criteria": [
        {
          "metric": "qualified",
          "op": "==",
          "value": true
        }
      ]
    }
  ]
}
