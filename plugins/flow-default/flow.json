{
  "id": "default",
  "version": "0.11.0",
  "stages": [
    {
      "id": "S0",
      "title": "Feasibility and cost estimate"
    },
    {
      "id": "S1",
      "title": "Model intake"
    },
    {
      "id": "S2",
      "title": "Numeric co-design"
    },
    {
      "id": "S3",
      "title": "Architecture design and exploration"
    },
    {
      "id": "S4",
      "title": "Hardware generation",
      "entry": {
        "checks": [
          {
            "check": "impl.views.S4",
            "slot": "storage-impl"
          }
        ]
      }
    },
    {
      "id": "S5",
      "title": "Functional verification"
    },
    {
      "id": "S6",
      "title": "Physical implementation",
      "entry": {
        "checks": [
          {
            "check": "impl.views.S6",
            "slot": "storage-impl"
          }
        ]
      }
    },
    {
      "id": "S7",
      "title": "Signoff",
      "entry": {
        "checks": [
          {
            "check": "impl.views.S7",
            "slot": "storage-impl"
          }
        ]
      }
    }
  ],
  "checks": [
    {
      "id": "estimate.feasibility",
      "version": "1",
      "title": "Feasibility estimate is feasible or conditionally feasible",
      "plugin": "estimator",
      "handler": "estimate",
      "completeness": [
        {
          "metric": "missing_count",
          "op": "==",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "feasible_or_conditional",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "impl.views.S4",
      "version": "1",
      "title": "Storage implementation has the integration views S4 needs",
      "plugin": "estimator",
      "handler": "check_views",
      "criteria": [
        {
          "metric": "views.S4.complete",
          "op": "==",
          "value": true
        },
        {
          "metric": "available",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "impl.views.S6",
      "version": "1",
      "title": "Storage implementation has the integration views S6 needs",
      "plugin": "estimator",
      "handler": "check_views",
      "criteria": [
        {
          "metric": "views.S6.complete",
          "op": "==",
          "value": true
        },
        {
          "metric": "available",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "impl.views.S7",
      "version": "1",
      "title": "Storage implementation has the integration views S7 needs",
      "plugin": "estimator",
      "handler": "check_views",
      "criteria": [
        {
          "metric": "views.S7.complete",
          "op": "==",
          "value": true
        },
        {
          "metric": "available",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "accuracy.budget",
      "version": "2",
      "title": "L2 accuracy against L0 within the budget (S2)",
      "plugin": "numeric",
      "handler": "evaluate",
      "completeness": [
        {
          "metric": "prompts_evaluated",
          "op": ">=",
          "value": 20
        },
        {
          "metric": "tokens_per_prompt",
          "op": ">=",
          "value": 64
        },
        {
          "metric": "passage_tokens",
          "op": ">=",
          "value": 100
        }
      ],
      "criteria": [
        {
          "metric": "ppl_increase_pct",
          "op": "<=",
          "value": 20
        }
      ]
    },
    {
      "id": "numeric.accuracy",
      "version": "1",
      "title": "L2 of a recovered graph within the accuracy budget against L0 (analysis)",
      "plugin": "numeric",
      "handler": "evaluate_graph",
      "completeness": [
        {
          "metric": "prompts_evaluated",
          "op": ">=",
          "value": 1
        },
        {
          "metric": "passage_tokens",
          "op": ">=",
          "value": 64
        }
      ],
      "criteria": [
        {
          "metric": "ppl_increase_pct",
          "op": "<=",
          "value": 20
        },
        {
          "metric": "teacher_forced_top1",
          "op": ">=",
          "value": 0.9
        }
      ]
    },
    {
      "id": "arch.spec",
      "version": "3",
      "title": "Chip spec follows the frozen numeric spec, covers every observation point, fits the area and, when a cycle target is set, meets it (S3)",
      "plugin": "arch-taalas",
      "handler": "verify_spec",
      "criteria": [
        {
          "metric": "numeric_spec_matches",
          "op": "==",
          "value": true
        },
        {
          "metric": "observation_points_covered",
          "op": "==",
          "value": true
        },
        {
          "metric": "fits_area",
          "op": "==",
          "value": true
        },
        {
          "metric": "cycles_match_model",
          "op": "==",
          "value": true
        },
        {
          "metric": "cycles_within_target",
          "op": "==",
          "value": true,
          "when": {
            "metric": "cycles_target_set",
            "op": "==",
            "value": true
          }
        }
      ]
    },
    {
      "id": "rtl.lint",
      "version": "1",
      "title": "Generated RTL is lint-clean (FR-RTL-03)",
      "plugin": "sim-verilator",
      "handler": "lint",
      "criteria": [
        {
          "metric": "lint_errors",
          "op": "==",
          "value": 0
        },
        {
          "metric": "lint_warnings",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "rtl.equivalence",
      "version": "2",
      "title": "Every item of the verification plan executed; L3 equals L2 bit for bit; coverage reaches the threshold (S5, AC-03)",
      "plugin": "sim-verilator",
      "handler": "verify",
      "requiredCapability": "rtl-functional-sim",
      "completeness": [
        {
          "metric": "items_not_executed",
          "op": "==",
          "value": 0
        },
        {
          "metric": "regression_prompts",
          "op": ">=",
          "value": 20
        },
        {
          "metric": "tokens_per_prompt",
          "op": ">=",
          "value": 64
        }
      ],
      "criteria": [
        {
          "metric": "items_failed",
          "op": "==",
          "value": 0
        },
        {
          "metric": "regression_mismatches",
          "op": "==",
          "value": 0
        },
        {
          "metric": "random_mismatches",
          "op": "==",
          "value": 0
        },
        {
          "metric": "coverage_line_pct",
          "op": ">=",
          "value": 90
        }
      ]
    },
    {
      "id": "sim-verilator.qualify.rtl-functional-sim",
      "version": "1",
      "title": "Qualification of the RTL functional simulation capability (FR-VER-01)",
      "plugin": "sim-verilator",
      "handler": "qualify",
      "criteria": [
        {
          "metric": "qualified",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "phy.drc",
      "version": "2",
      "title": "DRC (KLayout and Magic), antenna and density clean on the GDS (FR-SGN-01, AC-05)",
      "plugin": "eda-gf180",
      "handler": "drc",
      "completeness": [
        {
          "metric": "klayout_drc_errors",
          "op": ">=",
          "value": 0
        },
        {
          "metric": "magic_drc_errors",
          "op": ">=",
          "value": 0
        },
        {
          "metric": "antenna_errors",
          "op": ">=",
          "value": 0
        },
        {
          "metric": "density_errors",
          "op": ">=",
          "value": 0
        },
        {
          "metric": "klayout_markers_parsed",
          "op": "==",
          "value": true
        }
      ],
      "criteria": [
        {
          "metric": "klayout_drc_errors",
          "op": "==",
          "value": 0
        },
        {
          "metric": "magic_drc_errors",
          "op": "==",
          "value": 0
        },
        {
          "metric": "antenna_errors",
          "op": "==",
          "value": 0
        },
        {
          "metric": "density_errors",
          "op": "==",
          "value": 0
        },
        {
          "metric": "magic_illegal_overlaps",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "phy.lvs",
      "version": "1",
      "title": "LVS: the GDS matches the netlist (FR-SGN-01, AC-05)",
      "plugin": "eda-gf180",
      "handler": "lvs",
      "completeness": [
        {
          "metric": "lvs_complete",
          "op": "==",
          "value": true
        }
      ],
      "criteria": [
        {
          "metric": "lvs_error",
          "op": "==",
          "value": 0
        },
        {
          "metric": "lvs_device_difference",
          "op": "==",
          "value": 0
        },
        {
          "metric": "lvs_net_difference",
          "op": "==",
          "value": 0
        },
        {
          "metric": "lvs_unmatched_pin",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "phy.sta",
      "version": "1",
      "title": "Signoff STA: every corner, setup and hold, complete constraints, no unregistered exception (FR-SGN-02/02a/02b, AC-05/06)",
      "plugin": "eda-gf180",
      "handler": "sta",
      "completeness": [
        {
          "metric": "corners_checked",
          "op": ">=",
          "value": 9
        },
        {
          "metric": "clock_defined",
          "op": "==",
          "value": true
        },
        {
          "metric": "unconstrained_endpoints",
          "op": "==",
          "value": 0
        },
        {
          "metric": "unclocked_registers",
          "op": "==",
          "value": 0
        },
        {
          "metric": "ports_without_delay",
          "op": "==",
          "value": 0
        },
        {
          "metric": "port_delays_match_spec",
          "op": "==",
          "value": true
        },
        {
          "metric": "combinational_loops",
          "op": "==",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "setup_violations",
          "op": "==",
          "value": 0
        },
        {
          "metric": "hold_violations",
          "op": "==",
          "value": 0
        },
        {
          "metric": "max_slew_violations",
          "op": "==",
          "value": 0
        },
        {
          "metric": "max_cap_violations",
          "op": "==",
          "value": 0
        },
        {
          "metric": "max_fanout_violations",
          "op": "==",
          "value": 0
        },
        {
          "metric": "unregistered_exceptions",
          "op": "==",
          "value": 0
        },
        {
          "metric": "pad_transition_within_spec",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "phy.gatesim",
      "version": "1",
      "title": "Gate-level (zero-delay) simulation of the routed netlist equals L2 (FR-SGN-03, L4)",
      "plugin": "sim-verilator",
      "handler": "gatesim",
      "completeness": [
        {
          "metric": "gl_prompts",
          "op": ">=",
          "value": 2
        },
        {
          "metric": "gl_tokens_per_prompt",
          "op": ">=",
          "value": 8
        }
      ],
      "criteria": [
        {
          "metric": "gl_mismatches",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "sdf.timing",
      "version": "1",
      "title": "SDF timing simulation with complete back-annotation on a qualified backend (supplementary, FR-VER-02/03, AC-12)",
      "plugin": "sim-verilator",
      "handler": "sdfsim",
      "completeness": [
        {
          "metric": "sdf_annotation_complete",
          "op": "==",
          "value": true
        },
        {
          "metric": "sdf_ignored",
          "op": "==",
          "value": 0
        },
        {
          "metric": "sim_completed",
          "op": "==",
          "value": true
        }
      ],
      "criteria": [
        {
          "metric": "sim_errors",
          "op": "==",
          "value": 0
        }
      ],
      "requiredCapability": "sdf-timing-sim"
    },
    {
      "id": "model.census",
      "version": "1",
      "title": "Tensor census of the imported weights is self-consistent",
      "plugin": "model-llama",
      "handler": "import",
      "completeness": [
        {
          "metric": "tensors",
          "op": ">",
          "value": 0
        }
      ],
      "criteria": [
        {
          "metric": "all_tensors_classified",
          "op": "==",
          "value": true
        },
        {
          "metric": "header_consistent",
          "op": "==",
          "value": true
        },
        {
          "metric": "layers_uniform",
          "op": "==",
          "value": true
        },
        {
          "metric": "config_agrees",
          "op": "==",
          "value": true
        },
        {
          "metric": "output_consistent",
          "op": "==",
          "value": true
        }
      ]
    },
    {
      "id": "model.graph",
      "version": "1",
      "title": "Computation graph recovered with every tensor bound",
      "plugin": "model-llama",
      "handler": "recover",
      "criteria": [
        {
          "metric": "family_supported",
          "op": "==",
          "value": true
        },
        {
          "metric": "tensors_unmatched",
          "op": "==",
          "value": 0
        },
        {
          "metric": "tensors_missing",
          "op": "==",
          "value": 0
        }
      ]
    },
    {
      "id": "model.upstream",
      "version": "2",
      "title": "Recovered graph passes the full test suite against the official implementation",
      "plugin": "model-llama",
      "handler": "compare",
      "completeness": [
        {
          "metric": "prompts",
          "op": ">=",
          "value": 1
        },
        {
          "metric": "tests_total",
          "op": ">=",
          "value": 1
        }
      ],
      "criteria": [
        {
          "metric": "tests_failed",
          "op": "==",
          "value": 0
        },
        {
          "metric": "greedy_match",
          "op": "==",
          "value": true
        },
        {
          "metric": "top1_agreement",
          "op": ">=",
          "value": 0.99
        },
        {
          "metric": "max_rel_logit_diff",
          "op": "<=",
          "value": 0.001
        }
      ]
    },
    {
      "id": "vchip.l3",
      "version": "1",
      "title": "The RTL as a virtual chip under the pin-level testbench (design L3 acceptance): bit-exact with the L2 golden on 20 prompts to 64 tokens, cycles counted by the testbench and equal to the S3 chip spec, at least 1000 tok/s at the chip spec's clock",
      "plugin": "vchip",
      "handler": "bench",
      "completeness": [
        {
          "metric": "chip_backend",
          "op": "==",
          "value": "rtl"
        },
        {
          "metric": "prompts",
          "op": ">=",
          "value": 20
        },
        {
          "metric": "max_tokens",
          "op": ">=",
          "value": 64
        },
        {
          "metric": "golden_compared",
          "op": "==",
          "value": true
        },
        {
          "metric": "comparison_errors",
          "op": "==",
          "value": 0
        },
        {
          "metric": "design_cycles_source",
          "op": "==",
          "value": "chip.spec"
        },
        {
          "metric": "clock_source",
          "op": "==",
          "value": "chip.spec"
        }
      ],
      "criteria": [
        {
          "metric": "errors",
          "op": "==",
          "value": 0
        },
        {
          "metric": "bit_exact",
          "op": "==",
          "value": true
        },
        {
          "metric": "measurement_trusted",
          "op": "==",
          "value": true
        },
        {
          "metric": "cycles_match_design",
          "op": "==",
          "value": true
        },
        {
          "metric": "tok_s",
          "op": ">=",
          "value": 1000
        }
      ]
    },
    {
      "id": "vchip.conformance",
      "version": "1",
      "title": "Conformance of a virtual chip (design T-01 to T-19) on at least 20 prompts: no check fails, none left unrun; for an RTL chip, the acceptance part (T-18, T-19) at the L3 standard and the chip spec's clock",
      "plugin": "vchip",
      "handler": "conform",
      "completeness": [
        {
          "metric": "checks_not_run",
          "op": "==",
          "value": 0
        },
        {
          "metric": "prompts",
          "op": ">=",
          "value": 20
        },
        {
          "metric": "acceptance_bit_exact",
          "op": "==",
          "value": true,
          "when": {
            "metric": "chip_backend",
            "op": "==",
            "value": "rtl"
          }
        },
        {
          "metric": "acceptance_tok_s_min",
          "op": ">=",
          "value": 1000,
          "when": {
            "metric": "chip_backend",
            "op": "==",
            "value": "rtl"
          }
        },
        {
          "metric": "acceptance_max_tokens",
          "op": ">=",
          "value": 64,
          "when": {
            "metric": "chip_backend",
            "op": "==",
            "value": "rtl"
          }
        },
        {
          "metric": "clock_source",
          "op": "==",
          "value": "chip.spec",
          "when": {
            "metric": "chip_backend",
            "op": "==",
            "value": "rtl"
          }
        }
      ],
      "criteria": [
        {
          "metric": "checks_failed",
          "op": "==",
          "value": 0
        }
      ]
    }
  ],
  "hardConstraintSlots": [
    "constraints",
    "timing-exceptions",
    "signoff-rules"
  ]
}
